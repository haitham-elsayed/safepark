name: tests

on:
  push:
    branches: [main]
  pull_request:

jobs:
  e2e:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - name: Write local test vars
        run: |
          cat > .dev.vars <<'EOF'
          SETUP_SECRET=dev-setup-secret
          TELEGRAM_BOT_TOKEN=
          RESEND_API_KEY=
          EMAIL_FROM=SafePark <alerts@example.com>
          VAPID_PUBLIC_KEY=
          VAPID_PRIVATE_KEY=
          VAPID_SUBJECT=mailto:test@example.com
          APP_ORIGIN=http://localhost:8787
          EOF
      - run: bash test/run.sh
